// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  username      String?   @unique
  avatar        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  threads       Thread[]

  @@map("users")
}

model Thread {
  id            String        @id @default(cuid())
  userId        String
  title         String?       // Optional title for drafts
  status        ThreadStatus  @default(DRAFT)

  // Scheduling
  scheduledFor  DateTime?
  publishedAt   DateTime?

  // Metadata
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweets        Tweet[]

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@map("threads")
}

model Tweet {
  id            String    @id @default(cuid())
  threadId      String
  content       String
  order         Int       // Position in thread (0-based)

  // Media attachments (stored as JSON for SQLite compatibility)
  media         Json?     // { urls: string[], types: string[] }

  // Poll data (JSON for simplicity in MVP)
  pollData      Json?     // { question, options: [], duration }

  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  thread        Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("tweets")
}

enum ThreadStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
}
